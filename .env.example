# Fixed-address deployment: explicitly load using uvicorn --env-file .env.
# server.dev manages separate keys and data in .local-dev/.
# Replace this placeholder with a random token of at least 32 characters.
EAMS_ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_ADMIN_TOKEN_AT_LEAST_32_CHARACTERS
EAMS_DB=data/server.db
EAMS_PUBLIC_URL=https://eams.example.com
EAMS_TRANSPORT=polling

# Optional server.cloud entry: local pairing management behind your HTTPS proxy.
# Uses EAMS_PUBLIC_URL plus these settings; generates admin.key in EAMS_STATE_DIR.
# EAMS_DB and EAMS_ADMIN_TOKEN apply to server.app, not server.cloud.
EAMS_PORT=18080
EAMS_STATE_DIR=.local-dev

# Trusted LAN debugging only, with a compatible Debug APK.
EAMS_ALLOW_LAN_HTTP=0

# Legacy experiment only; inactive unless EAMS_TRANSPORT=jpush.
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
JPUSH_THIRD_PARTY_CHANNELS={}
